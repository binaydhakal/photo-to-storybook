"""Photo to Storybook 3D — standalone Blender character generator.

Run this file in Blender's Text Editor to show the Storybook panel in the
3D View sidebar (N). Or use:
  blender --background --factory-startup --python photo_to_storybook.py -- \
      --image /path/photo.jpg --output /path/results

Works locally, without an API key or uploading the photograph. Uses a
parametric anatomical template, not photogrammetry or a trained 3D generator.
The photo guides palette and face aspect; hair, garments, body and pose remain
preset-based. See the accompanying README for honest limits and controls.

Embedded MakeHuman asset data: CC0 1.0, MakeHuman Community.
https://github.com/makehumancommunity/makehuman/blob/master/LICENSE.ASSETS.md
Script code: MIT license. No affiliation with Studio Ghibli.
"""
bl_info = {'name':'Photo to Storybook 3D','author':'Photo to Storybook contributors','version':(1,0,0),
 'blender':(4,2,0),'location':'3D View > Sidebar > Storybook',
 'description':'Photo-guided, editable storybook/anime character generator','category':'Object'}
import bpy, math, json, random, pathlib, bmesh, sys, argparse, subprocess
import base64, zlib, zipfile, io, tempfile, hashlib, os, time
import numpy as np
from mathutils import Vector, Matrix
from mathutils.bvhtree import BVHTree
from math import sin, cos, pi, exp
from bpy.props import StringProperty, EnumProperty, BoolProperty, FloatProperty, FloatVectorProperty

DEFAULTS={'body':'neutral','hair':'swept','sunglasses':'auto','beard':False,
 'watch':False,'head_scale':1.20,'eye_scale':1.15,'shirt_text':'',
 'frame':'portrait','face_box':None,'seed':87,'render':True,'glb':True,
 'resolution':1000,'overwrite':False,'name':None,'skin_color':None,
 'hair_color':None,'shirt_color':None,'pants_color':None}

# The payload at the end of this script contains the CC0 base mesh, morphs,
# anatomical weights, skeleton, and license. No runtime downloads are made.
ASSET_PAYLOAD = '__ASSET_PAYLOAD__'
VISION_SOURCE = '__VISION_SOURCE__'

def cache_assets():
 key=hashlib.sha256(ASSET_PAYLOAD.encode()).hexdigest()[:12]
 folder=pathlib.Path(tempfile.gettempdir())/('storybook3d_'+key)
 folder.mkdir(parents=True,exist_ok=True)
 if not (folder/'base.obj').exists():
  raw=zlib.decompress(base64.b85decode(ASSET_PAYLOAD))
  with zipfile.ZipFile(io.BytesIO(raw)) as archive:
   for entry in archive.infolist():
    name=pathlib.Path(entry.filename)
    if name.name!=entry.filename:raise RuntimeError('Invalid embedded asset path')
    (folder/name.name).write_bytes(archive.read(entry))
 return folder

def linear(rgb):
 return [((c+.055)/1.055)**2.4 if c>.04045 else c/12.92 for c in rgb]

def morphs(cfg):
 # These are fixed template construction weights, not inferred identities.
 femininity={'masculine':0.,'neutral':.5,'feminine':1.}[cfg['body']]
 out=[]
 for gender,w in [('male',1-femininity),('female',femininity)]:
  for template,tw in [('asian',.4),('caucasian',.6)]:
   if w:out.append((template+'-'+gender+'-young',w*tw))
 return out+[('head-fat-incr',.23),('head-square',.04),('mouth-angles-up',.36)]

def detect_face(path,cache):
 """Return normalized [left,top,width,height]. Largest face wins explicitly."""
 notes=[]
 if sys.platform=='darwin' and pathlib.Path('/usr/bin/swift').exists():
  try:
   src=cache/'face_detector.swift';src.write_text(VISION_SOURCE)
   # Apple Vision is local. The timeout also covers first-run Swift startup.
   run=subprocess.run(['/usr/bin/swift',str(src),str(path)],capture_output=True,text=True,timeout=90)
   for line in reversed(run.stdout.splitlines()):
    try:
     data=json.loads(line)
     if data.get('bbox'):
      data['method']='Apple Vision (local)';return data,notes
    except (ValueError,TypeError):pass
   notes.append('Apple Vision did not find a face; using framing controls.')
  except (OSError,subprocess.TimeoutExpired):notes.append('Local face detector unavailable; using framing controls.')
 # Optional OpenCV if the user already installed it in Blender's Python.
 try:
  import cv2
  image=cv2.imread(str(path));gray=cv2.cvtColor(image,cv2.COLOR_BGR2GRAY)
  detector=cv2.CascadeClassifier(cv2.data.haarcascades+'haarcascade_frontalface_default.xml')
  boxes=detector.detectMultiScale(gray,1.1,5)
  if len(boxes):
   x,y,w,h=max(boxes,key=lambda b:b[2]*b[3]);ih,iw=gray.shape
   return {'bbox':[float(x/iw),float(y/ih),float(w/iw),float(h/ih)],'faces':len(boxes),'method':'OpenCV (local)'},notes
 except (ImportError,AttributeError,ValueError):pass
 except Exception as exc:notes.append('Optional OpenCV detector could not analyze this file: '+type(exc).__name__)
 return {},notes

def analyze_photo(path,cfg,cache):
 image=bpy.data.images.load(str(path),check_existing=False)
 width,height=map(int,image.size)
 if width==0 or height==0:raise ValueError('Cannot read this image. Use a supported PNG, JPEG, or WebP file.')
 if width<32 or height<32:raise ValueError('Use an image at least 32 × 32 pixels.')
 arr=np.empty(width*height*4,dtype=np.float32);image.pixels.foreach_get(arr)
 arr=arr.reshape(height,width,4)[::-1,:,:3].copy()
 # Keep analysis inexpensive for high-resolution photographs.
 step=max(1,max(width,height)//1200);arr=arr[::step,::step];hh,ww=arr.shape[:2]
 detector,notes=detect_face(path,cache) if cfg['face_box'] is None else ({},[])
 if cfg['face_box'] is not None:
  box=cfg['face_box'];method='Manual face box'
 elif detector.get('bbox'):
  box=detector['bbox'];method=detector['method']
 else:
  box=[.32,.12,.36,.40] if cfg['frame']=='portrait' else [.40,.05,.20,.18]
  method='Framing fallback';notes.append('Face was not detected. Correct face_box and colors if the draft looks wrong.')
 x,y,w,h=box
 if not (0<=x<1 and 0<=y<1 and w>0 and h>0 and x+w<=1.001 and y+h<=1.001):
  raise ValueError('face_box must be normalized [left, top, width, height] inside the image.')
 def region(a,b,c,d):
  a,b,c,d=max(0,a),max(0,b),min(1,c),min(1,d)
  if c<=a or d<=b:return np.empty((0,3))
  return arr[int(b*hh):max(int(b*hh)+1,int(d*hh)),int(a*ww):max(int(a*ww)+1,int(c*ww)),:].reshape(-1,3)
 def median(pixels,default,quantiles=(.15,.85)):
  if len(pixels)<12:return default
  lum=pixels@np.array([.2126,.7152,.0722]);lo,hi=np.quantile(lum,quantiles);p=pixels[(lum>=lo)&(lum<=hi)]
  return np.median(p,axis=0).clip(.015,.97).tolist() if len(p) else default
 # Cheek samples avoid most eyes, lips and the background; this remains a heuristic.
 cheeks=np.concatenate([region(x+w*.13,y+h*.42,x+w*.34,y+h*.69),region(x+w*.66,y+h*.42,x+w*.87,y+h*.69)])
 skin=median(cheeks,[.67,.43,.30],(.35,.85))
 hair=median(region(x-w*.08,y-h*.65,x+w*1.08,y+h*.03),[.12,.075,.04],(.04,.4))
 shirt=median(region(x+w*.08,y+h*1.45,x+w*.92,y+h*3.0),[.25,.43,.40],(.08,.55))
 pants=median(region(x-w*.05,y+h*4.3,x+w*1.05,y+h*5.8),[.38,.51,.62],(.20,.75))
 eyes=region(x+w*.10,y+h*.13,x+w*.90,y+h*.37)
 eye_lum=float(np.median(eyes@np.array([.2126,.7152,.0722]))) if len(eyes) else .5
 skin_lum=float(np.dot(skin,[.2126,.7152,.0722]));auto_glasses=eye_lum<skin_lum*.50
 for key,value in [('skin_color',skin),('hair_color',hair),('shirt_color',shirt),('pants_color',pants)]:
  # JSON and UI colors use familiar sRGB values, converted for Blender materials.
  cfg[key]=linear(cfg[key] if cfg[key] is not None else value)
 cfg['sunglasses']=auto_glasses if cfg['sunglasses']=='auto' else cfg['sunglasses']=='on'
 cfg['face_width']=float(np.clip((w*width)/(h*height),.72,1.15))
 if detector.get('faces',0)>1:notes.append('Multiple faces found; the largest face was used. Use face_box to choose a different person.')
 bpy.data.images.remove(image)
 return {'face_box':box,'face_method':method,'detected_faces':detector.get('faces',0),
  'notes':notes,'sampled_srgb':{'skin':skin,'hair':hair,'shirt':shirt,'pants':pants},
  'automatic_sunglasses':auto_glasses,'source_size':[width,height]}

def validate_config(cfg):
 allowed={'body':['neutral','masculine','feminine'],'hair':['swept','bob','long','bald'],
          'sunglasses':['auto','on','off'],'frame':['portrait','full-body']}
 for key,values in allowed.items():
  if cfg[key] not in values:raise ValueError(key+' must be one of '+', '.join(values))
 for key,lo,hi in [('head_scale',1.,1.5),('eye_scale',.8,1.7),('resolution',256,2048)]:
  if not lo<=float(cfg[key])<=hi:raise ValueError(f'{key} must be between {lo} and {hi}')
 for key in ['skin_color','hair_color','shirt_color','pants_color']:
  c=cfg[key]
  if c is not None and (len(c)!=3 or any(not 0<=float(v)<=1 for v in c)):raise ValueError(key+' must contain three sRGB numbers between 0 and 1')
 if cfg['face_box'] is not None and len(cfg['face_box'])!=4:raise ValueError('face_box needs four numbers')
 if cfg['name'] and (pathlib.Path(cfg['name']).name!=cfg['name'] or cfg['name'] in ['.','..']):raise ValueError('name must be a filename, without folders')

def build_character(CFG,ANALYSIS,IMAGE,OUT,MH):
 random.seed(int(CFG['seed']))
 ROOT=OUT

 bpy.ops.object.select_all(action='SELECT');bpy.ops.object.delete(use_global=False)
 for c in list(bpy.data.collections):
  if c.name!='Collection':bpy.data.collections.remove(c)
 main=bpy.data.collections.get('Collection');main.name='CHARACTER • Storybook'
 def coll(n):
  c=bpy.data.collections.new(n);bpy.context.scene.collection.children.link(c);return c
 stage=coll('STUDIO • cameras and lights');details=coll('DETAILS • garment stitching and print');haircoll=coll('HAIR • scalp and swept strands');source=coll('SOURCE • reference and notes')
 def move(o,c):
  for a in list(o.users_collection):a.objects.unlink(o)
  c.objects.link(o)
 def mat(n,col,rough=.5,metal=0):
  m=bpy.data.materials.new(n);m.diffuse_color=(*col,1);m.use_nodes=True;p=m.node_tree.nodes.get('Principled BSDF');p.inputs['Base Color'].default_value=(*col,1);p.inputs['Roughness'].default_value=rough;p.inputs['Metallic'].default_value=metal;return m
 skin=mat('Skin • warm medium tan',(.40,.205,.125),.5)
 p=skin.node_tree.nodes.get('Principled BSDF');p.inputs['Subsurface Weight'].default_value=.08;p.inputs['Subsurface Radius'].default_value=(1,.45,.25)
 cloth=mat('T-shirt • washed charcoal cotton',(.018,.02,.028),.87)
 denim=mat('Jeans • faded light indigo denim',(.24,.38,.53),.83)
 hairmat=mat('Hair • dark espresso',(.009,.004,.002),.72)
 hairlight=mat('Hair • warm brown highlights',(.026,.010,.004),.64)
 beardmat=mat('Beard • short dark brown',(.042,.021,.013),.66)
 metal=mat('Aviators • warm silver metal',(.58,.52,.4),.23,.85)
 lens=mat('Aviators • smoky blue reflective lenses',(.022,.041,.059),.16,.35)
 black=mat('Watch • black resin',(.016,.018,.024),.48)
 seammat=mat('Jeans • pale gold seam thread',(.37,.32,.21),.83)
 solemat=mat('Sneakers • warm off-white rubber',(.66,.64,.56),.68)
 shoemat=mat('Sneakers • charcoal canvas',(.038,.043,.054),.8)
 def noise_material(m,scale,amount,distance,col1=None,col2=None):
  nt=m.node_tree;p=nt.nodes.get('Principled BSDF');tex=nt.nodes.new('ShaderNodeTexNoise');tex.inputs['Scale'].default_value=scale;tex.inputs['Detail'].default_value=3
  b=nt.nodes.new('ShaderNodeBump');b.inputs['Strength'].default_value=amount;b.inputs['Distance'].default_value=distance;nt.links.new(tex.outputs['Fac'],b.inputs['Height']);nt.links.new(b.outputs['Normal'],p.inputs['Normal'])
  if col1:
   ramp=nt.nodes.new('ShaderNodeValToRGB');ramp.color_ramp.elements[0].position=.2;ramp.color_ramp.elements[0].color=(*col1,1);ramp.color_ramp.elements[1].position=.8;ramp.color_ramp.elements[1].color=(*col2,1);nt.links.new(tex.outputs['Fac'],ramp.inputs[0]);nt.links.new(ramp.outputs[0],p.inputs['Base Color'])
 noise_material(skin,175,.03,.0002)
 noise_material(cloth,135,.18,.00065,(.006,.007,.01),(.016,.018,.025))
 noise_material(denim,210,.22,.00065,(.16,.27,.39),(.28,.41,.55))
 def mesh(n,vs,fs,ma=None,c=main):
  me=bpy.data.meshes.new(n);me.from_pydata(vs,[],fs);me.update();o=bpy.data.objects.new(n,me);c.objects.link(o)
  if ma:o.data.materials.append(ma)
  for p in me.polygons:p.use_smooth=True
  return o
 def sub(o,n=1):
  m=o.modifiers.new('Editable subdivision','SUBSURF');m.levels=n;m.render_levels=n
  return m
 def solid(o,t=.002):
  m=o.modifiers.new('Fabric thickness','SOLIDIFY');m.thickness=t;m.offset=-1;return m
 def apply(o,m):
  bpy.context.view_layer.objects.active=o;o.select_set(True);bpy.ops.object.modifier_apply(modifier=m.name);o.select_set(False)
 def curve(n,points,r,ma,c=details,cyclic=False):
  cu=bpy.data.curves.new(n,'CURVE');cu.dimensions='3D';cu.resolution_u=12;cu.bevel_depth=r;cu.bevel_resolution=2
  sp=cu.splines.new('BEZIER');sp.bezier_points.add(len(points)-1)
  for p,co in zip(sp.bezier_points,points):p.co=co;p.handle_left_type='AUTO';p.handle_right_type='AUTO'
  sp.use_cyclic_u=cyclic;o=bpy.data.objects.new(n,cu);c.objects.link(o);o.data.materials.append(ma);return o
 def uvball(n,loc,scale,ma,c=main):
  bpy.ops.mesh.primitive_uv_sphere_add(segments=32,ring_count=20,location=loc);o=bpy.context.object;o.name=n;o.scale=scale;bpy.ops.object.transform_apply(location=False,rotation=False,scale=True);move(o,c);o.data.materials.append(ma)
  for p in o.data.polygons:p.use_smooth=True
  return o
 def cube(n,loc,scale,ma,bevel=.01,c=main):
  bpy.ops.mesh.primitive_cube_add(size=1,location=loc);o=bpy.context.object;o.name=n;o.scale=scale;bpy.ops.object.transform_apply(location=False,rotation=False,scale=True);move(o,c);o.data.materials.append(ma)
  if bevel:
   m=o.modifiers.new('Soft manufactured edges','BEVEL');m.width=bevel;m.segments=3
   m=o.modifiers.new('Corner normals','WEIGHTED_NORMAL')
  return o
 # MakeHuman CC0 anatomical topology; retain source indexing for skeleton and weights.
 v=[];uv=[];faces={};fu={};g=''
 for l in open(MH/'base.obj'):
  a=l.split()
  if not a:continue
  if a[0]=='v':v.append(Vector(tuple(map(float,a[1:]))))
  elif a[0]=='vt':uv.append(tuple(map(float,a[1:3])))
  elif a[0]=='g':g=a[1]
  elif a[0]=='f':
   faces.setdefault(g,[]).append([int(b.split('/')[0])-1 for b in a[1:]])
   fu.setdefault(g,[]).append([int(b.split('/')[1])-1 for b in a[1:]])
 for n,w in morphs(CFG):
  for l in open(MH/(n+'.target')):
   a=l.split()
   if a and not a[0].startswith('#'):v[int(a[0])]+=Vector(tuple(map(float,a[1:4])))*w
 bottom=min(p.y for p in v);scale=1.76/(max(p.y for p in v)-bottom)
 v=[Vector((p.x*scale,-p.z*scale,(p.y-bottom)*scale)) for p in v]
 J=json.load(open(MH/'default.mhskel'));W=json.load(open(MH/'default_weights.mhw'))['weights']
 def jt(n):
  ids=J['joints'][n];return sum((v[a] for a in ids),Vector())/len(ids)
 # Full source rig, used to create the reference pose. Retained for further editing.
 arm=bpy.data.armatures.new('Reference pose skeleton');rig=bpy.data.objects.new('Pose rig • anatomical base',arm);source.objects.link(rig);bpy.context.view_layer.objects.active=rig;rig.select_set(True);bpy.ops.object.mode_set(mode='EDIT')
 for n,b in J['bones'].items():
  eb=arm.edit_bones.new(n);eb.head=jt(b['head']);eb.tail=jt(b['tail'])
  if (eb.tail-eb.head).length<.0001:eb.tail.z+=.005
 for n,b in J['bones'].items():
  if b['parent']:arm.edit_bones[n].parent=arm.edit_bones[b['parent']]
 bpy.ops.object.mode_set(mode='OBJECT');rig.select_set(False)
 def fromgroup(group,name,ma):
  ids=sorted(set(i for f in faces[group] for i in f));mapping={a:i for i,a in enumerate(ids)};o=mesh(name,[v[i] for i in ids],[[mapping[a] for a in f] for f in faces[group]],ma)
  layer=o.data.uv_layers.new(name='Base UV')
  for p,uf in zip(o.data.polygons,fu[group]):
   for li,u in zip(p.loop_indices,uf):layer.data[li].uv=uv[u]
  for n,weights in W.items():
   selected=[(mapping[i],w) for i,w in weights if i in mapping]
   if selected:
    vg=o.vertex_groups.new(name=n)
    for i,w in selected:vg.add([i],w,'REPLACE')
  return o
 body=fromgroup('body','Body • anatomical quad mesh',skin)
 helper=fromgroup('helper-tights','Fitting surface',cloth)
 # Pose both arms: elbows relaxed outside torso, hands turning into pockets.
 def turn_chain(n,end,target):
  bpy.context.view_layer.update();pb=rig.pose.bones[n];pivot=pb.head.copy();old=rig.pose.bones[end].head-pivot;new=Vector(target)-pivot
  q=old.rotation_difference(new);pb.matrix=Matrix.Translation(pivot)@q.to_matrix().to_4x4()@Matrix.Translation(-pivot)@pb.matrix;bpy.context.view_layer.update()
 for side,s in [('L',1),('R',-1)]:
  turn_chain('upperarm01.'+side,'lowerarm01.'+side,(s*.264,-.014,1.162))
  turn_chain('lowerarm01.'+side,'wrist.'+side,(s*.196,-.070,.943))
  turn_chain('wrist.'+side,'finger3-1.'+side,(s*.18,.028,.835))
  # Curl the fingers, leaving the palm and thumb at the pocket opening.
  for n,pb in rig.pose.bones.items():
   if n.startswith('finger') and n.endswith('.'+side):
    pb.rotation_mode='XYZ';pb.rotation_euler.x=.20 if '1-' not in n else .12
 bpy.context.view_layer.update()
 for o in [body,helper]:
  m=o.modifiers.new('Reference hands-in-pockets pose','ARMATURE');m.object=rig;apply(o,m)
 for vert in body.data.vertices:
  if vert.co.z>1.505:
   f=min(1,(vert.co.z-1.505)/.04);vert.co.x*=1+.13*f
 # Sink the concealed palms and fingers into the trouser pockets.
 handgroups={g.index for g in body.vertex_groups if g.name.startswith(('wrist','finger','metacarpal'))}
 for vert in body.data.vertices:
  w=sum(g.weight for g in vert.groups if g.group in handgroups)
  f=min(1,max(0,(.957-vert.co.z)/.025))*min(1,w)
  vert.co.x-=math.copysign(.030*f,vert.co.x);vert.co.y+=.04*f
 body.data.update()
 # Static posed mesh stays editable. Source rig retained but hidden from export.
 rig.hide_render=True;rig.hide_set(True)
 # Store posed joint locations for fitted accessories.
 posed={n: {'head':list(pb.head),'tail':list(pb.tail)} for n,pb in rig.pose.bones.items()}
 # Construction measurements stay in memory.
 # Smooth clothing surfaces derived from helper topology with exact cut boundaries.
 def cut(o,co,normal,clear_inner=False,clear_outer=False):
  bm=bmesh.new();bm.from_mesh(o.data);bmesh.ops.bisect_plane(bm,geom=list(bm.verts)+list(bm.edges)+list(bm.faces),dist=.00001,plane_co=co,plane_no=normal,clear_inner=clear_inner,clear_outer=clear_outer);bm.to_mesh(o.data);bm.free()
 def duplicate(o,n,ma):
  q=o.copy();q.data=o.data.copy();q.name=n;main.objects.link(q);q.data.materials.clear();q.data.materials.append(ma);return q
 shirt=duplicate(helper,'T-shirt • loose washed cotton',cloth)
 cut(shirt,(0,0,1.015),(0,0,1),clear_inner=True)
 cut(shirt,(0,0,1.505),(0,0,1),clear_outer=True)
 # Sleeve cut below bicep; cross-section of the already lowered arms.
 # Remove remaining helper hands/forearms below the sleeve when outside torso.
 bm=bmesh.new();bm.from_mesh(shirt.data)
 remove=[f for f in bm.faces if abs(f.calc_center_median().x)>.204 and f.calc_center_median().z<1.205]
 bmesh.ops.delete(bm,geom=remove,context='FACES')
 seen=set();parts=[]
 for vert in bm.verts:
  if vert in seen:continue
  stack=[vert];part=set()
  while stack:
   q=stack.pop()
   if q in part:continue
   part.add(q);seen.add(q);stack.extend(e.other_vert(q) for e in q.link_edges if e.other_vert(q) not in part)
  parts.append(part)
 keep=max(parts,key=len);bmesh.ops.delete(bm,geom=[q for q in bm.verts if q not in keep],context='VERTS')
 bm.to_mesh(shirt.data);bm.free()
 for p in shirt.data.vertices:
  x,y,z=p.co
  if abs(x)<.205:
   f=min(1,max(0,(1.46-z)/.08));p.co.x*=1+.15*f
   p.co.y+=(-1 if y<-.015 else 1)*(.004+.027*f)
   p.co.y+=.0035*sin(x*83+z*55)*sin(z*24)
  else:
   p.co.x+=math.copysign(.022,x);p.co.y+=(-1 if y<-.025 else 1)*.022
 shirt.data.update()
 sm=shirt.modifiers.new('Relax drape','SMOOTH');sm.factor=.7;sm.iterations=4;apply(shirt,sm)
 sub(shirt,2);solid(shirt,.0025)
 jeans=duplicate(helper,'Jeans • straight fit with pocket openings',denim)
 cut(jeans,(0,0,1.04),(0,0,1),clear_outer=True);cut(jeans,(0,0,.105),(0,0,1),clear_inner=True)
 # Remove disconnected arm/hand helper parts above the hip.
 bm=bmesh.new();bm.from_mesh(jeans.data);bad=[f for f in bm.faces if abs(f.calc_center_median().x)>.255];bmesh.ops.delete(bm,geom=bad,context='FACES');# Only the connected trousers component survives; cut-off forearm helpers are discarded.
 seen=set();components=[]
 for vert in bm.verts:
  if vert in seen:continue
  stack=[vert];part=set()
  while stack:
   q=stack.pop()
   if q in part:continue
   part.add(q);seen.add(q)
   stack.extend(e.other_vert(q) for e in q.link_edges if e.other_vert(q) not in part)
  components.append(part)
 keep=max(components,key=len)
 bmesh.ops.delete(bm,geom=[q for q in bm.verts if q not in keep],context='VERTS')
 bm.to_mesh(jeans.data);bm.free()
 for p in jeans.data.vertices:
  x,y,z=p.co
  cx=math.copysign(.11+.072*max(0,(.9-z))/.8,x)
  if z<.85:
   p.co.x=cx+(x-cx)*1.15;p.co.y=y*1.14
  p.co.x+=math.copysign(.007,x);p.co.y+=(-1 if y<0 else 1)*.014
  # Low-amplitude gathered folds around knees and cuffs.
  fold=.0045*sin(88*z+10*x)*exp(-((z-.5)/.10)**2)+.005*sin(112*z+20*x)*exp(-((z-.15)/.09)**2)
