  if o.dimensions.x>.25:o.scale*=.25/o.dimensions.x
  bpy.ops.object.select_all(action='DESELECT');o.select_set(True);bpy.context.view_layer.objects.active=o;bpy.ops.object.convert(target='MESH')
  bm=bmesh.new();bm.from_mesh(o.data);bmesh.ops.triangulate(bm,faces=list(bm.faces));bmesh.ops.subdivide_edges(bm,edges=list(bm.edges),cuts=3,use_grid_fill=True);bm.to_mesh(o.data);bm.free()
  for p in o.data.vertices:
   worldv=o.matrix_world@p.co;p.co=o.matrix_world.inverted()@front(shirtbvh,worldv.x,worldv.z,.003)
 # Apply a common stylization transform to the head and all its accessories.
 pivot=Vector((0,-.02,1.505));head_scale=CFG['head_scale'];width_factor=float(np.clip(CFG['face_width']/1.0,.92,1.08))
 scalevec=Vector((head_scale*width_factor,head_scale*.96,head_scale*.95))
 for p in body.data.vertices:
  if p.co.z>1.505:
   f=min(1,(p.co.z-1.505)/.035);relative=p.co-pivot
   p.co=pivot+Vector(tuple(relative[i]*(1+(scalevec[i]-1)*f) for i in range(3)))
 transform=Matrix.Translation(pivot)@Matrix.Diagonal((*scalevec,1))@Matrix.Translation(-pivot)
 for o in list(main.objects)+list(haircoll.objects):
  if o==body:continue
  if o.name.startswith(('Hair •','Beard •','Sunglasses •','Face •')):o.matrix_world=transform@o.matrix_world
 # Soft daylight and a muted cel-animation palette.
 set_color(floor,(.28,.36,.32));world.node_tree.nodes['Background'].inputs[0].default_value=(.59,.71,.74,1);world.node_tree.nodes['Background'].inputs[1].default_value=.65
 for o in stage.objects:
  if o.type=='LIGHT':o.data.energy*=.85
 cam.data.ortho_scale=2.15;cam.location=(2,-7.5,2.25);cam.rotation_euler=(Vector((0,-.02,.98))-cam.location).to_track_quat('-Z','Y').to_euler();sc.camera=cam
 portraitcam.data.ortho_scale=.96;portraitcam.location=(.15,-7,1.85);portraitcam.rotation_euler=(Vector((0,-.06,1.47))-portraitcam.location).to_track_quat('-Z','Y').to_euler()
 sc.view_settings.view_transform='AgX';sc.cycles.samples=32;sc.render.resolution_x=CFG['resolution'];sc.render.resolution_y=int(CFG['resolution']*1.2)
 # Cel shading for the native Blender scene; GLB uses the underlying PBR shader.
 try:sc.render.engine='BLENDER_EEVEE_NEXT'
 except TypeError:sc.render.engine='BLENDER_EEVEE'
 toon_mats=[skin,cloth,denim,hairmat,hairlight,beardmat,shoemat,solemat,eyewhite,iris]
 for material in toon_mats:
  nt=material.node_tree;ps=nt.nodes.get('Principled BSDF');output=nt.nodes.get('Material Output')
  diffuse=nt.nodes.new('ShaderNodeBsdfDiffuse');diffuse.inputs['Color'].default_value=(1,1,1,1)
  rgb=nt.nodes.new('ShaderNodeShaderToRGB');nt.links.new(diffuse.outputs[0],rgb.inputs[0])
  ramp=nt.nodes.new('ShaderNodeValToRGB');ramp.label='Cel light bands';ramp.color_ramp.interpolation='CONSTANT'
  ramp.color_ramp.elements[0].position=.14;ramp.color_ramp.elements[0].color=(.47,.53,.60,1)
  ramp.color_ramp.elements[1].position=.60;ramp.color_ramp.elements[1].color=(1.12,1.08,1.0,1)
  middle=ramp.color_ramp.elements.new(.33);middle.color=(.83,.85,.86,1);nt.links.new(rgb.outputs[0],ramp.inputs[0])
  mix=nt.nodes.new('ShaderNodeMixRGB');mix.blend_type='MULTIPLY';mix.inputs[0].default_value=1;nt.links.new(ramp.outputs[0],mix.inputs[1])
  if ps.inputs['Base Color'].links:nt.links.new(ps.inputs['Base Color'].links[0].from_socket,mix.inputs[2])
  else:mix.inputs[2].default_value=ps.inputs['Base Color'].default_value
  emission=nt.nodes.new('ShaderNodeEmission');nt.links.new(mix.outputs[0],emission.inputs['Color']);nt.links.new(emission.outputs[0],output.inputs['Surface'])
 # Inverted hulls provide a thin drawn contour in the Blender presentation.
 outlines=coll('OUTLINES • generated toon contours');outline_mat=mat('Outline • warm ink',(.009,.007,.011),1);outline_mat.use_backface_culling=True
 bpy.context.view_layer.update()
 for original in [body,shirt,jeans]+[o for o in haircoll.objects if 'sculpted swept scalp' in o.name or 'curtain' in o.name]:
  thickness=[m for m in original.modifiers if m.type=='SOLIDIFY']
  for m in thickness:m.show_viewport=False
  bpy.context.view_layer.update()
  ev=original.evaluated_get(bpy.context.evaluated_depsgraph_get());me=ev.to_mesh();verts=[v.co+v.normal*.00135 for v in me.vertices]
  faces_out=[tuple(reversed(p.vertices)) for p in me.polygons if original!=body or p.center.z>1.505 or (abs(p.center.x)>.19 and 1.0<p.center.z<1.24)]
  hull=mesh('Contour • '+original.name,verts,faces_out,outline_mat,outlines);hull.matrix_world=original.matrix_world.copy();hull.parent=root;ev.to_mesh_clear()
  for m in thickness:m.show_viewport=True
 # Construction rig was used only to establish the static pose.
 for o in list(bpy.data.objects):
  if o.type=='ARMATURE':bpy.data.objects.remove(o,do_unlink=True)
 # Parent any late-created features to the single character root.
 for c in [main,details,haircoll]:
  for o in c.objects:
   if o!=root and not o.parent:o.parent=root
 name=CFG['name'] or (IMAGE.stem+'_storybook')
 native=OUT/(name+'.blend');exchange=OUT/(name+'.glb')
 packed=bpy.data.objects.new('Reference • input image (hidden)',None);source.objects.link(packed);packed.empty_display_type='IMAGE';packed.data=ref;packed.location=(-1.2,.4,1);packed.rotation_euler=(pi/2,0,0);packed.hide_render=True;packed.hide_set(True)
 notes={'generator':'Photo to Storybook 3D 1.0','input':IMAGE.name,'config':CFG,'analysis':ANALYSIS,
 'limitations':['Approximate parametric character, not photogrammetry.','Fixed adult standing pose; proportions, clothing and hidden surfaces are inferred.','No animation rig; single photo cannot recover unseen geometry.','Hair, beard and accessories are presets, not automatic semantic reconstruction.']}
 (OUT/(name+'_settings.json')).write_text(json.dumps(notes,indent=2))
 txt=bpy.data.texts.new('READ ME • generation notes');txt.write(json.dumps(notes,indent=2))
 bpy.ops.file.pack_all();bpy.ops.object.select_all(action='DESELECT');shirt.select_set(True);bpy.context.view_layer.objects.active=shirt
 for screen in bpy.data.screens:
  for area in screen.areas:
   if area.type=='VIEW_3D':
    area.spaces.active.region_3d.view_distance=3.;area.spaces.active.region_3d.view_location=(0,0,.98);area.spaces.active.region_3d.view_rotation=cam.rotation_euler.to_quaternion();area.spaces.active.shading.type='MATERIAL'
 sc.render.filepath=str(OUT/(name+'_preview.png'));bpy.ops.wm.save_as_mainfile(filepath=str(native))
 if CFG['render']:bpy.ops.render.render(write_still=True)
 if CFG['glb']:
  # Shader-to-RGB and contour hulls are Blender-specific; restore portable PBR.
  for material in toon_mats:
   nt=material.node_tree;nt.links.new(nt.nodes.get('Principled BSDF').outputs[0],nt.nodes.get('Material Output').inputs['Surface'])
  bpy.ops.object.select_all(action='DESELECT');export_objects=[]
  for c in [main,details,haircoll]:export_objects+=list(c.objects)
  for o in export_objects:
   o.hide_set(False);o.select_set(True)
   if o.type=='CURVE' and o.name.startswith(('Hair •','Beard •')):
    o.data.bevel_resolution=0
    if 'combed dark' in o.name:
     for spline in list(o.data.splines)[1::2]:o.data.splines.remove(spline)
   if o.type in ['MESH','CURVE']:
    for material in o.data.materials:
     if not material or material==skin:continue
     ps=material.node_tree.nodes.get('Principled BSDF')
     if ps:
      for link in list(ps.inputs['Base Color'].links):material.node_tree.links.remove(link)
      ps.inputs['Base Color'].default_value=material.diffuse_color
  bpy.context.view_layer.objects.active=body;bpy.ops.object.convert(target='MESH')
  bpy.ops.export_scene.gltf(filepath=str(exchange),export_format='GLB',use_selection=True,export_animations=False,export_cameras=False,export_lights=False,export_extras=True)
 return {'blend':str(native),'glb':str(exchange) if CFG['glb'] else None,'preview':str(OUT/(name+'_preview.png')) if CFG['render'] else None,'notes':ANALYSIS['notes']}

def run_cli(argv):
 p=argparse.ArgumentParser(description='Generate a photo-guided storybook/anime character in Blender.')
 p.add_argument('--image',required=True);p.add_argument('--output',required=True);p.add_argument('--config');p.add_argument('--name')
 p.add_argument('--body',choices=['neutral','masculine','feminine']);p.add_argument('--hair',choices=['swept','bob','long','bald'])
 p.add_argument('--sunglasses',choices=['auto','on','off']);p.add_argument('--beard',action='store_true',default=None);p.add_argument('--watch',action='store_true',default=None)
 p.add_argument('--frame',choices=['portrait','full-body']);p.add_argument('--face-box',type=float,nargs=4)
 p.add_argument('--head-scale',type=float);p.add_argument('--eye-scale',type=float);p.add_argument('--shirt-text');p.add_argument('--seed',type=int);p.add_argument('--resolution',type=int)
 p.add_argument('--no-render',action='store_true');p.add_argument('--no-glb',action='store_true');p.add_argument('--overwrite',action='store_true')
 args=p.parse_args(argv);cfg=dict(DEFAULTS)
 if args.config:
  data=json.loads(pathlib.Path(args.config).expanduser().read_text())
  unknown=set(data)-set(DEFAULTS)
  if unknown:raise ValueError('Unknown config keys: '+', '.join(sorted(unknown)))
  cfg.update(data)
 for key in DEFAULTS:
  value=getattr(args,key,None)
  if value is not None and key not in ['overwrite']:cfg[key]=value
 cfg['render']=not args.no_render and cfg['render'];cfg['glb']=not args.no_glb and cfg['glb'];cfg['overwrite']=args.overwrite or cfg['overwrite']
 validate_config(cfg)
 image=pathlib.Path(args.image).expanduser().resolve()
 if not image.is_file():raise FileNotFoundError('Photo not found: '+str(image))
 out=pathlib.Path(args.output).expanduser().resolve();stem=cfg['name'] or (image.stem+'_storybook')
 if not cfg['overwrite']:
  base=stem;i=2
  while any((out/(stem+s)).exists() for s in ['.blend','.glb','_preview.png','_settings.json']):stem=base+f'_{i:03d}';i+=1
 cfg['name']=stem
 original_cfg=dict(cfg)
 cache=cache_assets();analysis=analyze_photo(image,cfg,cache)
 recipe=dict(original_cfg);recipe['overwrite']=False;recipe['face_box']=analysis['face_box'];recipe['sunglasses']='on' if cfg['sunglasses'] else 'off'
 for key,short in [('skin_color','skin'),('hair_color','hair'),('shirt_color','shirt'),('pants_color','pants')]:
  if recipe[key] is None:recipe[key]=analysis['sampled_srgb'][short]
 out.mkdir(parents=True,exist_ok=True)
 result=build_character(cfg,analysis,image,out,cache)
 (out/(stem+'_recipe.json')).write_text(json.dumps(recipe,indent=2))
 print('STORYBOOK_RESULT='+json.dumps(result),flush=True)

JOBS={}
SCRIPT_PATH=pathlib.Path(globals().get('__file__','')).resolve()
class STORYBOOK_Settings(bpy.types.PropertyGroup):
 image: StringProperty(name='Person photo',subtype='FILE_PATH')
 output: StringProperty(name='Save folder',subtype='DIR_PATH',default='//storybook_output/')
 body: EnumProperty(name='Body preset',items=[(x,x.title(),'Template preference, not inferred from the photo') for x in ['neutral','masculine','feminine']],default='neutral')
 hair: EnumProperty(name='Hair',items=[(x,x.title(),'') for x in ['swept','bob','long','bald']],default='swept')
 sunglasses: EnumProperty(name='Sunglasses',items=[('auto','Estimate from photo','Heuristic; override if incorrect'),('on','On',''),('off','Off','')],default='auto')
 beard: BoolProperty(name='Short beard',default=False)
 watch: BoolProperty(name='Wristwatch',default=False)
 head_scale: FloatProperty(name='Head stylization',min=1,max=1.5,default=1.2)
 eye_scale: FloatProperty(name='Eye size',min=.8,max=1.7,default=1.15)
 frame: EnumProperty(name='Fallback framing',items=[('portrait','Portrait',''),('full-body','Full body','')],default='portrait')
 manual_face: BoolProperty(name='Use manual face box',default=False)
 face_box: FloatVectorProperty(name='Left / Top / Width / Height',size=4,min=0,max=1,default=(.32,.12,.36,.40))
 custom_colors: BoolProperty(name='Override sampled colors',default=False)
 skin_color: FloatVectorProperty(name='Skin',subtype='COLOR_GAMMA',size=3,min=0,max=1,default=(.68,.45,.32))
 hair_color: FloatVectorProperty(name='Hair',subtype='COLOR_GAMMA',size=3,min=0,max=1,default=(.16,.095,.055))
 shirt_color: FloatVectorProperty(name='Shirt',subtype='COLOR_GAMMA',size=3,min=0,max=1,default=(.30,.47,.40))
 pants_color: FloatVectorProperty(name='Trousers',subtype='COLOR_GAMMA',size=3,min=0,max=1,default=(.38,.52,.64))
 shirt_text: StringProperty(name='Shirt lettering',default='',maxlen=32)
 render: BoolProperty(name='Render a preview',default=True)
 glb: BoolProperty(name='Also export GLB',default=True)
 status: StringProperty(default='Choose a photo to begin.')
 last_blend: StringProperty(default='',subtype='FILE_PATH')

class STORYBOOK_OT_generate(bpy.types.Operator):
 bl_idname='storybook.generate';bl_label='Create Storybook Character';bl_description='Generate in a separate Blender process, preserving the currently open file'
 def execute(self,context):
  if JOBS:self.report({'WARNING'},'A character is already being generated.');return {'CANCELLED'}
  st=context.scene.storybook_settings;photo=pathlib.Path(bpy.path.abspath(st.image)).expanduser();out=pathlib.Path(bpy.path.abspath(st.output)).expanduser()
  if not photo.is_file():self.report({'ERROR'},'Choose an existing photograph.');return {'CANCELLED'}
  if not SCRIPT_PATH.is_file():self.report({'ERROR'},'Save this script as a .py file, reopen it, then Run Script.');return {'CANCELLED'}
  out.mkdir(parents=True,exist_ok=True)
  cfg={k:getattr(st,k) for k in ['body','hair','sunglasses','beard','watch','head_scale','eye_scale','frame','shirt_text','render','glb']}
  if st.manual_face:cfg['face_box']=list(st.face_box)
  if st.custom_colors:
   for k in ['skin_color','hair_color','shirt_color','pants_color']:cfg[k]=list(getattr(st,k))
  cache=cache_assets();stamp=str(time.time_ns());cf=cache/('job_'+stamp+'.json');cf.write_text(json.dumps(cfg));log=out/('storybook_job_'+stamp+'.log');handle=log.open('w')
  cmd=[bpy.app.binary_path,'--background','--factory-startup','--python-exit-code','1','--python',str(SCRIPT_PATH),'--','--image',str(photo),'--output',str(out),'--config',str(cf)]
  try:process=subprocess.Popen(cmd,stdout=handle,stderr=subprocess.STDOUT)
  except OSError as exc:handle.close();self.report({'ERROR'},str(exc));return {'CANCELLED'}
  st.status='Generating… Blender can stay open.';scene=context.scene
  JOBS.update(process=process,handle=handle,log=log)
  def tick():
   if process.poll() is None:return 1.0
   handle.close();content=log.read_text(errors='replace');JOBS.clear()
   try:
    results=[line.split('STORYBOOK_RESULT=',1)[1] for line in content.splitlines() if line.startswith('STORYBOOK_RESULT=')]
    if process.returncode==0 and results:
     result=json.loads(results[-1]);scene.storybook_settings.last_blend=result['blend'];scene.storybook_settings.status='Created: '+pathlib.Path(result['blend']).name
    else:scene.storybook_settings.status='Could not finish. See '+log.name
    for window in bpy.context.window_manager.windows:
     for area in window.screen.areas:area.tag_redraw()
   except ReferenceError:pass
   return None
  bpy.app.timers.register(tick,first_interval=1.)
  return {'FINISHED'}

class STORYBOOK_OT_open(bpy.types.Operator):
 bl_idname='storybook.open_result';bl_label='Open Generated Blender File'
 def invoke(self,context,event):return context.window_manager.invoke_confirm(self,event)
 def execute(self,context):
  path=context.scene.storybook_settings.last_blend
  if not pathlib.Path(path).is_file():return {'CANCELLED'}
  bpy.ops.wm.open_mainfile(filepath=path);return {'FINISHED'}

class STORYBOOK_PT_panel(bpy.types.Panel):
 bl_label='Photo to Storybook 3D';bl_idname='STORYBOOK_PT_panel';bl_space_type='VIEW_3D';bl_region_type='UI';bl_category='Storybook'
 def draw(self,context):
  l=self.layout;s=context.scene.storybook_settings
  l.label(text='Photo-guided character, approximate likeness.')
  l.prop(s,'image');l.prop(s,'output');l.prop(s,'body');l.prop(s,'hair');l.prop(s,'sunglasses')
  row=l.row();row.prop(s,'beard');row.prop(s,'watch')
  l.prop(s,'head_scale');l.prop(s,'eye_scale');l.prop(s,'shirt_text')
  box=l.box();box.label(text='Photo sampling');box.prop(s,'frame');box.prop(s,'manual_face')
  if s.manual_face:box.prop(s,'face_box')
  box.prop(s,'custom_colors')
  if s.custom_colors:
   for k in ['skin_color','hair_color','shirt_color','pants_color']:box.prop(s,k)
  row=l.row();row.prop(s,'render');row.prop(s,'glb')
  row=l.row();row.enabled=not bool(JOBS);row.operator('storybook.generate',icon='OUTLINER_OB_ARMATURE')
  l.label(text=s.status[:64])
  if s.last_blend:l.operator('storybook.open_result',icon='FILE_BLEND')
CLASSES=(STORYBOOK_Settings,STORYBOOK_OT_generate,STORYBOOK_OT_open,STORYBOOK_PT_panel)
def register():
 for cls in reversed(CLASSES):
  old=getattr(bpy.types,cls.__name__,None)
  if old:
   try:bpy.utils.unregister_class(old)
   except RuntimeError:pass
 if hasattr(bpy.types.Scene,'storybook_settings'):del bpy.types.Scene.storybook_settings
 for cls in CLASSES:bpy.utils.register_class(cls)
 bpy.types.Scene.storybook_settings=bpy.props.PointerProperty(type=STORYBOOK_Settings)
def unregister():
 if hasattr(bpy.types.Scene,'storybook_settings'):del bpy.types.Scene.storybook_settings
 for cls in reversed(CLASSES):
  try:bpy.utils.unregister_class(cls)
  except RuntimeError:pass
if __name__=='__main__':
 if bpy.app.background and '--' in sys.argv:run_cli(sys.argv[sys.argv.index('--')+1:])
 else:register();print('Photo to Storybook: open 3D View > N sidebar > Storybook.')
