 def bvh_of(o):
  dg=bpy.context.evaluated_depsgraph_get();ev=o.evaluated_get(dg);me=ev.to_mesh();tree=BVHTree.FromPolygons([p.co for p in me.vertices],[list(p.vertices) for p in me.polygons]);ev.to_mesh_clear();return tree
 bodybvh=bvh_of(body)
