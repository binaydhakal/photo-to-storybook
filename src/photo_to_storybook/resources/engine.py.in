 def front(tree,x,z,offset=.001):
  h=tree.ray_cast(Vector((x,-1,z)),Vector((0,1,0)))
  if h[0] is None and tree==jeansbvh:
   for k in range(1,20):
    xx=x*(1-k*.025);h=tree.ray_cast(Vector((xx,-1,z)),Vector((0,1,0)))
    if h[0]:return h[0]+Vector((0,-offset,0))
  return Vector((x,h[0].y-offset,z)) if h[0] else Vector((x,-.12,z))
 def back(tree,x,z,offset=.001):
  h=tree.ray_cast(Vector((x,1,z)),Vector((0,-1,0)))
  return Vector((x,h[0].y+offset,z)) if h[0] else Vector((x,.13,z))
 # Round knit collar follows the cut edge.
 def boundaryloops(o):
  counts={}
  for p in o.data.polygons:
   for a,b in p.edge_keys:counts[(min(a,b),max(a,b))]=counts.get((min(a,b),max(a,b)),0)+1
  adj={}
  for (a,b),n in counts.items():
   if n==1:adj.setdefault(a,[]).append(b);adj.setdefault(b,[]).append(a)
  loops=[];seen=set()
  for a in adj:
   if a in seen:continue
   path=[];cur=a;prev=-1
   while cur not in seen:
    seen.add(cur);path.append(cur);opts=[x for x in adj[cur] if x!=prev]
    if not opts:break
    prev,cur=cur,opts[0]
   if len(path)>3:loops.append([o.data.vertices[i].co.copy() for i in path])
  return loops
