 def multi_strands(n,paths,r,ma,c=haircoll):
  cu=bpy.data.curves.new(n,'CURVE');cu.dimensions='3D';cu.resolution_u=1;cu.bevel_depth=r;cu.bevel_resolution=1
  for points in paths:
   sp=cu.splines.new('POLY');sp.points.add(len(points)-1)
   for k,(p,co) in enumerate(zip(sp.points,points)):p.co=(*co,1);p.radius=max(.08,sin(pi*(k+.5)/len(points))**.4)
  o=bpy.data.objects.new(n,cu);c.objects.link(o);o.data.materials.append(ma);return o
