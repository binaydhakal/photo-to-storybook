 nt=skin.node_tree;vc=nt.nodes.new('ShaderNodeVertexColor');vc.layer_name='Skin tones';nt.links.new(vc.outputs['Color'],nt.nodes.get('Principled BSDF').inputs['Base Color'])
 # Scalp shell and combed strands sample actual skull shape.
 center=Vector((0,-.029,1.669))
 def hairpoint(a,t,extra=0):
  direction=Vector((sin(t)*cos(a),sin(t)*sin(a),cos(t)))
  # Cast from outside toward the head, avoiding internal mouth surfaces.
  hit=bodybvh.ray_cast(center+direction*.3,-direction,.4)
  p=hit[0] if hit[0] else center+Vector((direction.x*.077,direction.y*.09,direction.z*.084))
  lift=.003+.014*max(0,cos(t))
  lift+=.022*exp(-((a-4.1)/1.1)**2)*max(0,cos(t))*sin(t)
  return p+direction*(lift+extra)
 def max_t(a):
  # Front hairline high, short sides, longer nape.
  frontness=max(0,-sin(a));backness=max(0,sin(a))
  return 1.95-.55*frontness+.18*backness+.025*sin(a*9)
 hv=[];hf=[];NA=100;NT=20
 for j in range(NT+1):
  for i in range(NA):
   a=2*pi*i/NA;t=.015+(max_t(a)-.015)*j/NT;hv.append(hairpoint(a,t))
