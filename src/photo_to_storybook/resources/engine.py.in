 # Use real photo colors with a restrained hand-painted material variation.
 def set_color(material,color,paint=False):
  material.diffuse_color=(*color,1);nt=material.node_tree;ps=nt.nodes.get('Principled BSDF')
  ps.inputs['Base Color'].default_value=(*color,1);ps.inputs['Roughness'].default_value=.82
  for node in nt.nodes:
   if node.type=='VALTORGB':
    node.color_ramp.elements[0].color=(*[v*.80 for v in color],1)
    node.color_ramp.elements[1].color=(*[min(1,v*1.12+.003) for v in color],1)
  if not paint:
   for link in list(ps.inputs['Base Color'].links):nt.links.remove(link)
