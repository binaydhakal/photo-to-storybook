  for k in range(9):
   u=k/8;aa=a+sweep*u;tt=max(.035,t-length*u)
   pts.append(hairpoint(aa,tt,.001+sin(pi*u)*.004))
  (lightpaths if i%9==0 else paths).append(pts)
